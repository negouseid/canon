# Local demo: npm ci, copy this file to .env, then npm start.
PORT=3000
DATABASE_PATH=./data/canon.sqlite
SEED_ON_START=true
# Seconds without a canon/lore command or channel event before a lore ticker callback; 0 disables.
IDLE_LORE_SECONDS=180

# Twitch: enable after registering your application and creating the reward.
TWITCH_ENABLED=false
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=
TWITCH_BOT_USERNAME=
# Optional numeric ID: validated against the broadcaster account if supplied.
TWITCH_BROADCASTER_ID=
TWITCH_REWARD_TITLE=Canonize this
# Leave blank to derive http://localhost:PORT/auth/twitch/callback.
TWITCH_OAUTH_REDIRECT_URI=

# Editable persona only. AI voice rewriting is omitted in this release.
VOICE_PATH=./voice.md
